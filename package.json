    "test:compressed": "node tools/test-compressed.mjs",
    "detect": "node tools/detect-report.mjs",
    "serve": "node tools/serve.mjs 8770"
  },
  "peerDependencies": {
    "crashcat": "0.0.5",
    "three": "0.186.0"
  },
  "devDependencies": {
